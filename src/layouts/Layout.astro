---
interface Props {
    title: string;
    description?: string;
    image?: string;
    type?: 'website' | 'article';
    publishedTime?: Date;
}

const siteName = 'Koncevision TV';
const {
    title,
    description = 'Noticias al instante, redactadas y publicadas de forma automática.',
    image = '/placeholder.svg',
    type = 'website',
    publishedTime,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site).toString();

const jsonLd =
    type === 'article'
        ? {
              '@context': 'https://schema.org',
              '@type': 'NewsArticle',
              headline: title,
              description,
              image: [imageURL],
              datePublished: publishedTime?.toISOString(),
              publisher: {
                  '@type': 'Organization',
                  name: siteName,
              },
          }
        : null;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title} | {siteName}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />
        <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />

        <meta property="og:type" content={type} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={imageURL} />
        <meta property="og:site_name" content={siteName} />
        <meta property="og:url" content={canonicalURL} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageURL} />

        {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    </head>
    <body style="margin: 0; font-family: system-ui, sans-serif; background-color: #f9fafb; color: #111827;">
        <slot />
    </body>
</html>
