---
interface Props {
    titulo: string;
    resumen: string;
    imagenUrl?: string;
    enlace: string;
    categoria: string;
    fecha: Date;
    compacta?: boolean;
}
const { titulo, resumen, imagenUrl, enlace, categoria, fecha, compacta = false } = Astro.props;
const fechaFormateada = fecha.toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Santiago' });
---

<article class:list={['tarjeta', { 'tarjeta-compacta': compacta }]}>
    <a href={enlace} class="tarjeta-imagen-link">
        {imagenUrl ? (
            <img
                src={imagenUrl}
                alt={titulo}
                width={600}
                height={400}
                loading="lazy"
                class="tarjeta-imagen"
                onerror="this.onerror=null;this.src='/placeholder.svg';"
            />
        ) : (
            <img src="/placeholder.svg" alt={titulo} loading="lazy" class="tarjeta-imagen" />
        )}
        <span class="tarjeta-categoria">{categoria}</span>
    </a>
    <div class="tarjeta-cuerpo">
        <h2 class="tarjeta-titulo">
            <a href={enlace}>{titulo}</a>
        </h2>
        {!compacta && (
            <>
                <p class="tarjeta-fecha">{fechaFormateada}</p>
                <p class="tarjeta-resumen">{resumen}</p>
            </>
        )}
    </div>
</article>

<style>
    .tarjeta {
        border-bottom: 1px solid var(--rojo-konce);
        padding-bottom: 24px;
        margin-bottom: 24px;
    }

    .tarjeta-compacta {
        padding-bottom: 0;
        margin-bottom: 0;
        border-bottom: none;
    }

    .tarjeta-compacta .tarjeta-cuerpo {
        padding-top: 10px;
    }

    .tarjeta-compacta .tarjeta-titulo {
        font-size: 1rem;
        line-height: 1.3;
    }

    .tarjeta-imagen-link {
        position: relative;
        display: block;
    }

    .tarjeta-imagen {
        width: 100%;
        height: auto;
        aspect-ratio: 3 / 2;
        object-fit: cover;
        object-position: top;
        display: block;
    }

    .tarjeta-categoria {
        position: absolute;
        left: 0;
        bottom: 0;
        background: var(--rojo-konce);
        color: white;
        font-family: var(--fuente-display);
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        padding: 4px 12px;
    }

    .tarjeta-cuerpo {
        padding-top: 16px;
    }

    .tarjeta-titulo {
        font-size: 1.4rem;
        line-height: 1.2;
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        text-transform: none;
        letter-spacing: normal;
    }

    .tarjeta-titulo a {
        text-decoration: none;
        color: var(--carbon);
    }

    .tarjeta-titulo a:hover {
        color: var(--rojo-konce);
    }

    .tarjeta-resumen {
        font-family: 'Lora', serif;
        color: #4b5563;
        line-height: 1.6;
        margin-top: 10px;
    }

    .tarjeta-fecha {
        font-family: var(--fuente-cuerpo);
        color: #9ca3af;
        font-size: 0.82rem;
        margin-top: 6px;
    }
</style>
