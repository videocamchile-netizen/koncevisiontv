---
import { slugCategoria } from '../data/categorias.mjs';
import programa from '../data/ultimo-programa.json';
import { getCollection } from 'astro:content';

interface Props {
    anuncioLateral?: boolean;
    ultimasNoticias?: { id: string; titulo: string; tiempo: string }[];
}

const { anuncioLateral = false, ultimasNoticias = [] } = Astro.props;

const CATEGORIAS_DESTACADAS = ['Nacional', 'Internacional', 'Economía'];

const masLeidas = (await getCollection('noticias'))
    .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())
    .slice(0, 5);

const miniaturaPrograma = `https://i.ytimg.com/vi/${programa.videoId}/hqdefault.jpg`;
---

<aside class="sidebar">
    {ultimasNoticias.length > 0 && (
        <section class="bloque">
            <h2 class="bloque-titulo">Últimas Noticias</h2>
            <ul class="lista-leidas">
                {ultimasNoticias.map((noticia) => (
                    <li>
                        <a href={`/noticias/${noticia.id}`}>
                            <span class="lista-ultimas-cuerpo">
                                <span class="lista-ultimas-tiempo">{noticia.tiempo}</span>
                                <span>{noticia.titulo}</span>
                            </span>
                        </a>
                    </li>
                ))}
            </ul>
        </section>
    )}

    <section class="bloque">
        <h2 class="bloque-titulo">Más Leídas</h2>
        {masLeidas.length === 0 ? (
            <p class="bloque-vacio">Todavía no hay noticias publicadas.</p>
        ) : (
            <ol class="lista-leidas">
                {masLeidas.map((noticia, indice) => (
                    <li>
                        <a href={`/noticias/${noticia.id}`}>
                            <span class="numero">{indice + 1}</span>
                            <span>{noticia.data.titulo}</span>
                        </a>
                    </li>
                ))}
            </ol>
        )}
    </section>

    <section class="bloque">
        <h2 class="bloque-titulo bloque-titulo-serif">Categorías</h2>
        <ul class="lista-categorias">
            {CATEGORIAS_DESTACADAS.map((categoria) => (
                <li>
                    <a href={`/categoria/${slugCategoria(categoria)}`}>{categoria}</a>
                </li>
            ))}
        </ul>
    </section>

    <section class="bloque">
        <h2 class="bloque-titulo">{programa.enVivo ? '🔴 En Vivo' : 'Último Programa'}</h2>
        <a href="/ultimo-programa" class="programa-card">
            <img src={miniaturaPrograma} alt={programa.titulo} loading="lazy" />
            <span>{programa.titulo}</span>
        </a>
    </section>

    <a href="https://www.youtube.com/@KoncevisionTV" target="_blank" rel="noopener noreferrer" class="boton-youtube-sidebar">
        ▶ Síguenos en YouTube
    </a>

    {anuncioLateral && (
        <div class="anuncio-lateral">
            <a href="https://www.funerariasrenacer.cl/" target="_blank" rel="noopener noreferrer">
                <img src="/anuncios/renacer.jpg" alt="Funeraria Renacer — Servicios funerarios, Colón 1361, Talcahuano" />
            </a>
        </div>

        <div class="anuncio-lateral">
            <a href="https://eamcconstrucciones.cl/" target="_blank" rel="noopener noreferrer">
                <img src="/anuncios/eamc.webp" alt="EAMC Construcciones" />
            </a>
        </div>
    )}
</aside>

<style>
    .sidebar {
        display: flex;
        flex-direction: column;
        border-left: 1px solid var(--rojo-konce);
        padding-left: 24px;
    }

    .bloque {
        padding: 24px 0;
        border-top: 1px solid var(--rojo-konce);
    }

    .bloque:first-child {
        padding-top: 0;
        border-top: none;
    }

    .bloque-titulo {
        font-size: 1.1rem;
        border-bottom: 3px solid var(--rojo-konce);
        padding-bottom: 8px;
        margin-bottom: 14px;
    }

    .bloque-titulo-serif {
        font-family: 'Playfair Display', serif;
        font-weight: 800;
        text-transform: none;
        letter-spacing: normal;
    }

    .bloque-vacio {
        color: #6b7280;
        font-size: 0.9rem;
        margin: 0;
    }

    .lista-leidas {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
    }

    .lista-leidas li {
        padding: 12px 0;
        border-bottom: 1px dashed var(--borde-suave);
    }

    .lista-leidas li:first-child {
        padding-top: 0;
    }

    .lista-leidas li:last-child {
        padding-bottom: 0;
        border-bottom: none;
    }

    .lista-leidas a {
        display: flex;
        gap: 10px;
        text-decoration: none;
        color: var(--carbon);
        font-size: 0.95rem;
        line-height: 1.4;
        font-family: 'Playfair Display', serif;
        font-weight: 600;
    }

    .lista-leidas a:hover {
        color: var(--rojo-konce);
    }

    .numero {
        font-family: var(--fuente-display);
        color: var(--rojo-konce);
        font-size: 1.2rem;
        line-height: 1;
        flex-shrink: 0;
    }

    .lista-ultimas-cuerpo {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .lista-ultimas-tiempo {
        font-family: var(--fuente-cuerpo);
        color: var(--rojo-konce);
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .lista-categorias {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .lista-categorias a {
        text-decoration: none;
        color: var(--carbon);
        font-family: 'Playfair Display', serif;
        font-weight: 600;
        text-transform: none;
        letter-spacing: normal;
    }

    .lista-categorias a:hover {
        color: var(--rojo-konce);
    }

    .programa-card {
        display: block;
        text-decoration: none;
        color: var(--carbon);
    }

    .programa-card img {
        width: 100%;
        border-radius: 4px;
        display: block;
        margin-bottom: 10px;
    }

    .programa-card span {
        font-size: 0.9rem;
        font-weight: 600;
    }

    .programa-card:hover span {
        color: var(--rojo-konce);
    }

    .boton-youtube-sidebar {
        display: block;
        text-align: center;
        background: var(--rojo-konce);
        color: white;
        text-decoration: none;
        padding: 12px;
        border-radius: 4px;
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        text-transform: none;
        letter-spacing: normal;
    }

    .boton-youtube-sidebar:hover {
        background: var(--rojo-konce-oscuro);
    }

    .anuncio-lateral {
        margin-top: 24px;
    }

    .anuncio-lateral img {
        width: 100%;
        border-radius: 4px;
        display: block;
    }
</style>
