---
interface Props {
    clave?: string;
    etiqueta?: string;
}

const { clave = 'visitas-totales-v2', etiqueta = 'Visitas' } = Astro.props;
const idContenedor = `contador-visitas-${clave}`;
const idNumero = `contador-numero-${clave}`;
---

<div class="contador-visitas" id={idContenedor} aria-live="polite">
    <span class="contador-etiqueta">{etiqueta}</span>
    <span class="contador-numero" id={idNumero}>···</span>
</div>

<script define:vars={{ clave, idContenedor, idNumero }}>
    const NAMESPACE = 'koncevisiontv';
    const contenedor = document.getElementById(idContenedor);
    const numero = document.getElementById(idNumero);

    fetch(`https://abacus.jasoncameron.dev/hit/${NAMESPACE}/${clave}`)
        .then((respuesta) => respuesta.json())
        .then((datos) => {
            if (numero && typeof datos.value === 'number') {
                numero.textContent = datos.value.toLocaleString('es-CL');
            } else {
                contenedor?.remove();
            }
        })
        .catch(() => contenedor?.remove());
</script>

<style>
    .contador-visitas {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: var(--fuente-mono);
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        color: var(--gris-metalico);
    }

    .contador-etiqueta {
        text-transform: uppercase;
    }

    .contador-numero {
        color: var(--rojo-konce);
        font-weight: 600;
    }
</style>
