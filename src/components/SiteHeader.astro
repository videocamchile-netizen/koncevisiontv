---
---

<header class="site-header">
    <div class="contenedor barra">
        <a href="/" class="marca">
            <img src="/logo-koncevision.jpg" alt="Koncevision TV" class="marca-logo" width="80" height="80" />
            <span class="marca-nombre">KONCE<strong>VISION</strong> TV.CL</span>
        </a>

        <a
            href="https://www.youtube.com/@KoncevisionTV"
            target="_blank"
            rel="noopener noreferrer"
            class="boton-youtube"
        >
            ▶ Síguenos en YouTube
        </a>
    </div>

    <nav class="categorias-nav">
        <div class="contenedor categorias-lista">
            <a href="/">Inicio</a>
            <a href="/directo" class="link-directo">
                <span class="punto-directo"></span>
                Directo Sin Censura
            </a>
            <a href="/categoria/nacional">Nacional</a>
            <a href="/categoria/internacional">Internacional</a>
            <a href="/categoria/economia">Economía</a>
            <a href="/ultimo-programa">En Vivo / Último Programa</a>
            <a href="/publicidad">Publicidad</a>
        </div>
    </nav>
</header>

<style>
    .site-header {
        background: var(--azul-estudio);
    }

    .barra {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 16px 20px;
        flex-wrap: wrap;
    }

    .marca {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: var(--blanco-senal);
    }

    .marca-logo {
        border-radius: 50%;
        display: block;
    }

    .marca-nombre {
        font-family: var(--fuente-display);
        font-size: 2.75rem;
        font-weight: 800;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        line-height: 1;
    }

    @media (max-width: 640px) {
        .marca-nombre {
            font-size: 1.8rem;
        }
    }

    .marca-nombre strong {
        color: var(--rojo-konce);
    }

    .boton-youtube {
        background: var(--rojo-konce);
        color: var(--blanco-senal);
        text-decoration: none;
        padding: 8px 16px;
        border-radius: 4px;
        white-space: nowrap;
        font-family: var(--fuente-display);
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .boton-youtube:hover {
        background: var(--rojo-konce-oscuro);
    }

    .categorias-nav {
        background: var(--carbon);
        border-top: 1px solid var(--azul-medianoche);
        border-bottom: 3px solid var(--rojo-konce);
        overflow-x: auto;
    }

    .categorias-lista {
        display: flex;
        gap: 28px;
        padding: 12px 20px;
        white-space: nowrap;
        font-family: var(--fuente-display);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        font-size: 0.95rem;
    }

    .categorias-lista a {
        color: var(--blanco-senal);
        text-decoration: none;
    }

    .categorias-lista a:hover {
        color: var(--rojo-konce);
    }

    .link-directo {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--rojo-konce) !important;
        font-weight: 700;
    }

    .punto-directo {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--rojo-konce);
        animation: parpadeo-nav 1.4s ease-in-out infinite;
    }

    @keyframes parpadeo-nav {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.25; }
    }

    @media (prefers-reduced-motion: reduce) {
        .punto-directo {
            animation: none;
        }
    }
</style>
