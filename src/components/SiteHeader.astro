---
---

<header class="site-header">
    <div class="contenedor barra">
        <a href="/" class="marca">
            <img src="/logo-koncevision.jpg" alt="Koncevision TV" class="marca-logo" width="80" height="80" />
            <span class="marca-nombre">KONCE<strong>VISION</strong> TV.CL</span>
        </a>

        <a
            href="https://www.youtube.com/@KoncevisionTV"
            target="_blank"
            rel="noopener noreferrer"
            class="boton-youtube"
        >
            ▶ Síguenos en YouTube
        </a>
    </div>

    <nav class="categorias-nav">
        <div class="contenedor categorias-lista">
            <a href="/">Inicio</a>
            <a href="/directo" class="link-directo">
                <span class="punto-directo"></span>
                Directo Sin Censura
            </a>
            <a href="/categoria/nacional">Nacional</a>
            <a href="/categoria/internacional">Internacional</a>
            <a href="/categoria/economia">Economía</a>
            <a href="/ultimo-programa" class="link-en-vivo" id="linkEnVivoNav">
                <span class="punto-en-vivo" id="puntoEnVivoNav"></span>
                En Vivo
            </a>
            <a href="/publicidad">Publicidad</a>
        </div>
    </nav>
</header>

<script>
    (function () {
        const CHANNEL_ID = 'UCvdeRKMWaVgk7sQM_0zRqrQ';
        const link = document.getElementById('linkEnVivoNav');
        if (!link) return;

        function marcarEnVivo(activo) {
            link.classList.toggle('on', activo);
        }

        function verificarEnVivo() {
            const url = `https://www.youtube.com/oembed?url=https://www.youtube.com/channel/${CHANNEL_ID}/live&format=json`;
            fetch(url)
                .then((r) => marcarEnVivo(r.ok))
                .catch(() => marcarEnVivo(false));
        }

        verificarEnVivo();
        setInterval(verificarEnVivo, 3 * 60 * 1000);
    })();
</script>

<style>
    .site-header {
        background: var(--azul-estudio);
    }

    .barra {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 16px 20px;
        flex-wrap: wrap;
    }

    .marca {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: var(--blanco-senal);
    }

    .marca-logo {
        border-radius: 50%;
        display: block;
    }

    .marca-nombre {
        font-family: var(--fuente-display);
        font-size: 2.75rem;
        font-weight: 800;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        line-height: 1;
    }

    @media (max-width: 640px) {
        .marca-nombre {
            font-size: 1.8rem;
        }
    }

    .marca-nombre strong {
        color: var(--rojo-konce);
    }

    .boton-youtube {
        background: var(--rojo-konce);
        color: var(--blanco-senal);
        text-decoration: none;
        padding: 8px 16px;
        border-radius: 4px;
        white-space: nowrap;
        font-family: var(--fuente-display);
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .boton-youtube:hover {
        background: var(--rojo-konce-oscuro);
    }

    .categorias-nav {
        background: var(--carbon);
        border-top: 1px solid var(--azul-medianoche);
        border-bottom: 3px solid var(--rojo-konce);
        overflow-x: auto;
    }

    .categorias-lista {
        display: flex;
        gap: 28px;
        padding: 12px 20px;
        white-space: nowrap;
        font-family: var(--fuente-display);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        font-size: 0.95rem;
    }

    .categorias-lista a {
        color: var(--blanco-senal);
        text-decoration: none;
    }

    .categorias-lista a:hover {
        color: var(--rojo-konce);
    }

    .link-directo {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .punto-directo {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--rojo-konce);
        animation: parpadeo-nav 1.4s ease-in-out infinite;
    }

    @keyframes parpadeo-nav {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.25; }
    }

    @media (prefers-reduced-motion: reduce) {
        .punto-directo {
            animation: none;
        }
    }

    .link-en-vivo {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .punto-en-vivo {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.25);
        transition: background-color 0.3s ease;
    }

    .link-en-vivo.on {
        color: var(--rojo-konce) !important;
        font-weight: 700;
    }

    .link-en-vivo.on .punto-en-vivo {
        background: var(--rojo-konce);
        animation: parpadeo-nav 1.4s ease-in-out infinite;
    }
</style>
