---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Publicidad | Contacto Comercial">
    <main class="contenedor pagina-publicidad">
        <h1 class="titulo-publicidad">Impulsa tu marca con nosotros</h1>
        <p class="intro-publicidad">Llega a miles de lectores diarios publicando en nuestra red de noticias automatizada. Cuéntanos qué necesitas y te enviamos nuestros planes y valores.</p>

        <div class="videos-demo">
            <video class="video-demo video-demo-vertical" src="/publicidad-demo-vertical-2.mp4" controls preload="metadata"></video>
            <video class="video-demo video-demo-horizontal" src="/publicidad-demo.mp4" controls preload="metadata"></video>
            <video class="video-demo video-demo-vertical" src="/publicidad-demo-vertical.mp4" controls preload="metadata"></video>
        </div>

        <section class="contacto">
            <h2>Contacto Comercial</h2>
            <form class="form-contacto" id="form-publicidad">
                <input type="hidden" name="access_key" value="6c541092-0582-4682-8784-52fbe725cf24" />
                <input type="hidden" name="subject" value="Koncevisiontv desde página web" />
                <input type="text" name="empresa" placeholder="Nombre de tu Empresa" required />
                <input type="tel" name="telefono" placeholder="Teléfono" required />
                <input type="email" name="email" placeholder="Correo electrónico" required />
                <select name="tipo_publicidad" required>
                    <option value="" selected disabled>¿Qué tipo de publicidad te interesa?</option>
                    <option value="mencion-youtube">Mención en YouTube</option>
                    <option value="banner-youtube">Banner en YouTube</option>
                    <option value="grafica-destacada">Gráfica destacada en el sitio</option>
                    <option value="spot-video">Spot / Video comercial</option>
                    <option value="mencion-directo">Mención en "Directo Sin Censura" (transmisión en vivo)</option>
                    <option value="paquete-combinado">Paquete combinado (varios formatos)</option>
                    <option value="otro">Otro / no estoy seguro</option>
                </select>
                <textarea name="mensaje" placeholder="Cuéntanos más detalles (opcional)" rows="4"></textarea>
                <button type="submit">Enviar Solicitud</button>
                <p class="form-estado" id="form-estado" role="status"></p>
            </form>
        </section>
    </main>
</Layout>

<script>
    const formulario = document.getElementById('form-publicidad') as HTMLFormElement;
    const estado = document.getElementById('form-estado') as HTMLParagraphElement;

    formulario.addEventListener('submit', async (evento) => {
        evento.preventDefault();
        const boton = formulario.querySelector('button') as HTMLButtonElement;
        boton.disabled = true;
        estado.textContent = 'Enviando...';
        estado.className = 'form-estado';

        try {
            const respuesta = await fetch('https://api.web3forms.com/submit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                body: JSON.stringify(Object.fromEntries(new FormData(formulario))),
            });
            const resultado = await respuesta.json();

            if (resultado.success) {
                estado.textContent = '¡Gracias! Recibimos tu solicitud, te contactaremos pronto.';
                estado.className = 'form-estado form-estado-ok';
                formulario.reset();
            } else {
                throw new Error(resultado.message);
            }
        } catch {
            estado.textContent = 'No pudimos enviar tu solicitud. Intenta de nuevo o escríbenos directo.';
            estado.className = 'form-estado form-estado-error';
        } finally {
            boton.disabled = false;
        }
    });
</script>

<style>
    .pagina-publicidad {
        padding: 40px 20px;
    }

    .titulo-publicidad {
        font-size: 2rem;
        margin-bottom: 10px;
    }

    .intro-publicidad {
        color: #4b5563;
        font-size: 1.1rem;
        margin: 0;
        max-width: 640px;
    }

    .videos-demo {
        display: flex;
        align-items: flex-end;
        justify-content: center;
        flex-wrap: wrap;
        gap: 24px;
        margin-top: 30px;
    }

    .video-demo {
        display: block;
        border-radius: 4px;
        background: var(--azul-estudio);
    }

    .video-demo-horizontal {
        flex: 3 1 320px;
        max-width: 480px;
        aspect-ratio: 16 / 9;
        width: 100%;
    }

    .video-demo-vertical {
        flex: 1 1 140px;
        max-width: 220px;
        aspect-ratio: 480 / 880;
        width: 100%;
    }

    .contacto {
        background: var(--azul-estudio);
        color: var(--blanco-senal);
        padding: 30px;
        margin-top: 40px;
        border-radius: 4px;
    }

    .contacto h2 {
        margin-bottom: 20px;
        font-size: 1.4rem;
    }

    .form-contacto {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .form-contacto input,
    .form-contacto select,
    .form-contacto textarea {
        padding: 12px;
        border: 1px solid var(--azul-medianoche);
        border-radius: 4px;
        font-family: var(--fuente-cuerpo);
        background: white;
        color: var(--carbon);
    }

    .form-contacto select:invalid {
        color: #6b7280;
    }

    .form-contacto button {
        background: var(--rojo-konce);
        color: white;
        padding: 12px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-family: var(--fuente-display);
        text-transform: uppercase;
        letter-spacing: 0.03em;
        font-size: 1rem;
    }

    .form-contacto button:hover {
        background: var(--rojo-konce-oscuro);
    }

    .form-contacto button:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .form-estado {
        margin: 0;
        font-size: 0.95rem;
        min-height: 1.2em;
    }

    .form-estado-ok {
        color: #86efac;
    }

    .form-estado-error {
        color: #fca5a5;
    }
</style>
