---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Anuncia con Nosotros | Media Kit">
    <main class="contenedor pagina-publicidad">
        <h1 class="titulo-publicidad">Impulsa tu marca en la región</h1>
        <p class="intro-publicidad">Llega a miles de lectores diarios publicando en nuestra red de noticias automatizada.</p>

        <section class="planes">
            <div class="plan">
                <h3>Banner Portada</h3>
                <p>Ubicación privilegiada al entrar al sitio. Máxima visibilidad.</p>
                <p class="precio">$50.000 CLP <span>/ mes</span></p>
            </div>
            <div class="plan">
                <h3>Banner Artículos</h3>
                <p>Aparece orgánicamente en medio de las noticias que la gente lee.</p>
                <p class="precio">$35.000 CLP <span>/ mes</span></p>
            </div>
        </section>

        <section class="contacto">
            <h2>Contacto Comercial</h2>
            <form class="form-contacto">
                <input type="text" placeholder="Nombre de tu Empresa" required />
                <input type="email" placeholder="Correo electrónico" required />
                <textarea placeholder="¿En qué plan estás interesado?" rows="4" required></textarea>
                <button type="submit">Enviar Solicitud</button>
            </form>
        </section>
    </main>
</Layout>

<style>
    .pagina-publicidad {
        padding: 40px 20px;
    }

    .titulo-publicidad {
        font-size: 2rem;
        margin-bottom: 10px;
    }

    .intro-publicidad {
        color: #4b5563;
        font-size: 1.1rem;
        margin: 0;
    }

    .planes {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        margin-top: 40px;
    }

    .plan {
        border: 1px solid var(--borde-suave);
        border-top: 4px solid var(--rojo-konce);
        padding: 25px;
        flex: 1;
        min-width: 250px;
        border-radius: 4px;
    }

    .plan h3 {
        margin-bottom: 8px;
        font-size: 1.2rem;
    }

    .plan p {
        color: #6b7280;
        font-size: 14px;
    }

    .precio {
        color: var(--azul-estudio);
        font-family: var(--fuente-display);
        font-size: 1.5rem;
        margin-bottom: 0;
    }

    .precio span {
        font-size: 14px;
        color: #9ca3af;
        font-weight: normal;
        font-family: var(--fuente-cuerpo);
    }

    .contacto {
        background: var(--azul-estudio);
        color: var(--blanco-senal);
        padding: 30px;
        margin-top: 40px;
        border-radius: 4px;
    }

    .contacto h2 {
        margin-bottom: 20px;
        font-size: 1.4rem;
    }

    .form-contacto {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .form-contacto input,
    .form-contacto textarea {
        padding: 12px;
        border: 1px solid var(--azul-medianoche);
        border-radius: 4px;
        font-family: var(--fuente-cuerpo);
        background: white;
    }

    .form-contacto button {
        background: var(--rojo-konce);
        color: white;
        padding: 12px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-family: var(--fuente-display);
        text-transform: uppercase;
        letter-spacing: 0.03em;
        font-size: 1rem;
    }

    .form-contacto button:hover {
        background: var(--rojo-konce-oscuro);
    }
</style>
