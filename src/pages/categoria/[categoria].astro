---
import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/NewsCard.astro';
import ViewfinderFrame from '../../components/ViewfinderFrame.astro';
import Sidebar from '../../components/Sidebar.astro';
import { CATEGORIAS, slugCategoria } from '../../data/categorias.mjs';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
    return CATEGORIAS.map((categoria) => ({
        params: { categoria: slugCategoria(categoria) },
        props: { categoria },
    }));
}

const { categoria } = Astro.props;
const noticias = (await getCollection('noticias', ({ data }) => data.categoria === categoria)).sort(
    (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf(),
);

const CATEGORIAS_CON_DIAGRAMACION = ['Nacional', 'Internacional'];
const conDiagramacion = CATEGORIAS_CON_DIAGRAMACION.includes(categoria) && noticias.length > 2;

function tiempoRelativo(fecha) {
    const minutos = Math.floor((Date.now() - fecha.valueOf()) / 60000);
    if (minutos < 1) return 'Recién';
    if (minutos < 60) return `hace ${minutos} minuto${minutos === 1 ? '' : 's'}`;
    const horas = Math.floor(minutos / 60);
    if (horas < 24) return `hace ${horas} hora${horas === 1 ? '' : 's'}`;
    const dias = Math.floor(horas / 24);
    return `hace ${dias} día${dias === 1 ? '' : 's'}`;
}

function agruparEnBloques(lista, tamano) {
    const bloques = [];
    for (let i = 0; i < lista.length; i += tamano) {
        bloques.push(lista.slice(i, i + tamano));
    }
    return bloques;
}

const principal = conDiagramacion ? noticias[0] : undefined;
const secundaria = conDiagramacion ? noticias[1] : undefined;
const listaLateral = conDiagramacion ? noticias.slice(2, 7) : [];
const compactas = conDiagramacion ? noticias.slice(7, 11) : [];
const restoNoticias = conDiagramacion ? noticias.slice(11) : noticias;
const bloquesResto = conDiagramacion ? agruparEnBloques(restoNoticias, 4) : [];
---

<Layout title={categoria} description={`Últimas noticias de ${categoria} en Koncevision TV.`}>
    <main class="contenedor pagina-categoria">
        <div class="layout-con-sidebar">
            <div class="columna-principal">
                <h1 class="categoria-titulo">{categoria}</h1>

                {noticias.length === 0 && (
                    <p class="vacio-categoria">Todavía no hay noticias publicadas en esta categoría. Vuelve pronto.</p>
                )}

                {conDiagramacion && principal && (
                    <section class="hero-categoria">
                        <ViewfinderFrame>
                            <a href={`/noticias/${principal.id}`} class="hero-principal-link">
                                {principal.data.imagen ? (
                                    <img
                                        src={principal.data.imagen}
                                        alt={principal.data.titulo}
                                        width={800}
                                        height={500}
                                        class="hero-principal-imagen"
                                    />
                                ) : (
                                    <img src="/placeholder.svg" alt={principal.data.titulo} class="hero-principal-imagen" />
                                )}
                                <div class="hero-principal-chyron">
                                    <span class="hero-tag">{principal.data.categoria}</span>
                                    <h2 class="hero-principal-titulo">{principal.data.titulo}</h2>
                                </div>
                            </a>
                        </ViewfinderFrame>

                        {secundaria && (
                            <a href={`/noticias/${secundaria.id}`} class="hero-secundaria-link">
                                {secundaria.data.imagen ? (
                                    <img
                                        src={secundaria.data.imagen}
                                        alt={secundaria.data.titulo}
                                        width={600}
                                        height={375}
                                        class="hero-secundaria-imagen"
                                    />
                                ) : (
                                    <img src="/placeholder.svg" alt={secundaria.data.titulo} class="hero-secundaria-imagen" />
                                )}
                                <span class="hero-tag hero-tag-secundaria">{secundaria.data.categoria}</span>
                                <h3 class="hero-secundaria-titulo">{secundaria.data.titulo}</h3>
                                <p class="hero-secundaria-resumen">{secundaria.data.resumen}</p>
                            </a>
                        )}

                        {listaLateral.length > 0 && (
                            <div class="hero-lista">
                                <h2 class="hero-lista-titulo">
                                    <span class="hero-lista-punto"></span>
                                    Últimas Noticias
                                </h2>
                                <ul class="hero-lista-items">
                                    {listaLateral.map((noticia) => (
                                        <li>
                                            <a href={`/noticias/${noticia.id}`}>
                                                <span class="hero-lista-tiempo">
                                                    {tiempoRelativo(noticia.data.agregada ?? noticia.data.fecha)}
                                                </span>
                                                <span class="hero-lista-titulo-item">{noticia.data.titulo}</span>
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        )}
                    </section>
                )}

                {conDiagramacion && compactas.length > 0 && (
                    <div class="noticias-grid-compacta">
                        {compactas.map((noticia) => (
                            <NewsCard
                                compacta
                                categoria={noticia.data.categoria}
                                enlace={`/noticias/${noticia.id}`}
                                imagenUrl={noticia.data.imagen}
                                resumen={noticia.data.resumen}
                                titulo={noticia.data.titulo}
                                fecha={noticia.data.fecha}
                            />
                        ))}
                    </div>
                )}

                {conDiagramacion &&
                    bloquesResto.map((bloque) => (
                        <div class="bloque-resto">
                            {bloque[0] && (
                                <div class="bloque-item">
                                    <NewsCard
                                        categoria={bloque[0].data.categoria}
                                        enlace={`/noticias/${bloque[0].id}`}
                                        imagenUrl={bloque[0].data.imagen}
                                        resumen={bloque[0].data.resumen}
                                        titulo={bloque[0].data.titulo}
                                        fecha={bloque[0].data.fecha}
                                    />
                                </div>
                            )}

                            {bloque[1] && (
                                <div class="bloque-item">
                                    <NewsCard
                                        categoria={bloque[1].data.categoria}
                                        enlace={`/noticias/${bloque[1].id}`}
                                        imagenUrl={bloque[1].data.imagen}
                                        resumen={bloque[1].data.resumen}
                                        titulo={bloque[1].data.titulo}
                                        fecha={bloque[1].data.fecha}
                                    />
                                </div>
                            )}

                            {(bloque[2] || bloque[3]) && (
                                <div class="bloque-teasers-fila">
                                    {[bloque[2], bloque[3]].filter(Boolean).map((noticia) => (
                                        <a href={`/noticias/${noticia.id}`} class="bloque-teasers-fila-item">
                                            {noticia.data.titulo}
                                        </a>
                                    ))}
                                </div>
                            )}
                        </div>
                    ))}

                {!conDiagramacion && (
                    <div class="noticias-grid">
                        {noticias.map((noticia) => (
                            <NewsCard
                                categoria={noticia.data.categoria}
                                enlace={`/noticias/${noticia.id}`}
                                imagenUrl={noticia.data.imagen}
                                resumen={noticia.data.resumen}
                                titulo={noticia.data.titulo}
                                fecha={noticia.data.fecha}
                            />
                        ))}
                    </div>
                )}
            </div>

            <Sidebar />
        </div>
    </main>
</Layout>

<style>
    .pagina-categoria {
        padding: 32px 20px;
    }

    .categoria-titulo {
        border-bottom: 3px solid var(--rojo-konce);
        padding-bottom: 10px;
        margin-bottom: 24px;
        font-size: 2rem;
        font-family: 'Playfair Display', serif;
        font-weight: 800;
        text-transform: none;
        letter-spacing: normal;
    }

    .vacio-categoria {
        color: #6b7280;
    }

    .hero-categoria {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr;
        align-items: start;
        gap: 24px;
        margin-bottom: 32px;
        padding-bottom: 32px;
        border-bottom: 1px solid var(--rojo-konce);
    }

    /* El marco ViewfinderFrame compartido tiene un bug de color heredado (ver
       memoria del proyecto): los bordes con ancho explícito quedan en
       currentColor en vez de rojo. Se corrige acotado a esta instancia en vez
       de tocar el componente/global.css compartido. */
    .hero-categoria :global(.esquina.sup-izq) {
        border-top-color: var(--rojo-konce);
        border-left-color: var(--rojo-konce);
    }

    .hero-categoria :global(.esquina.sup-der) {
        border-top-color: var(--rojo-konce);
        border-right-color: var(--rojo-konce);
    }

    .hero-categoria :global(.esquina.inf-izq) {
        border-bottom-color: var(--rojo-konce);
        border-left-color: var(--rojo-konce);
    }

    .hero-categoria :global(.esquina.inf-der) {
        border-bottom-color: var(--rojo-konce);
        border-right-color: var(--rojo-konce);
    }

    .hero-principal-link {
        display: block;
        position: relative;
        text-decoration: none;
    }

    .hero-principal-imagen {
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        object-position: top;
        display: block;
    }

    .hero-principal-chyron {
        position: absolute;
        left: 0;
        bottom: 0;
        max-width: 92%;
        background: linear-gradient(0deg, rgba(14, 27, 46, 0.95), rgba(14, 27, 46, 0.7));
        padding: 18px 20px;
    }

    .hero-tag {
        display: inline-block;
        background: var(--rojo-konce);
        color: white;
        font-family: var(--fuente-display);
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        padding: 4px 12px;
        margin-bottom: 8px;
    }

    .hero-principal-titulo {
        color: white;
        font-size: 1.5rem;
        line-height: 1.2;
        font-family: 'Playfair Display', serif;
        font-weight: 800;
        text-transform: none;
        letter-spacing: normal;
    }

    .hero-secundaria-link {
        display: block;
        text-decoration: none;
        color: var(--carbon);
    }

    .hero-secundaria-imagen {
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        object-position: top;
        display: block;
        margin-bottom: 10px;
    }

    .hero-tag-secundaria {
        margin-bottom: 8px;
    }

    .hero-secundaria-titulo {
        font-size: 1.1rem;
        line-height: 1.25;
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        text-transform: none;
        letter-spacing: normal;
    }

    .hero-secundaria-link:hover .hero-secundaria-titulo {
        color: var(--rojo-konce);
    }

    .hero-secundaria-resumen {
        font-family: 'Lora', serif;
        color: #4b5563;
        font-size: 0.88rem;
        line-height: 1.5;
        margin-top: 8px;
    }

    .hero-lista-titulo {
        display: flex;
        align-items: center;
        gap: 8px;
        border-bottom: 3px solid var(--rojo-konce);
        padding-bottom: 8px;
        margin-bottom: 14px;
        font-size: 1.1rem;
    }

    .hero-lista-punto {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--rojo-konce);
        flex-shrink: 0;
    }

    .hero-lista-items {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
    }

    .hero-lista-items li {
        padding: 10px 0;
        border-bottom: 1px dashed var(--borde-suave);
    }

    .hero-lista-items li:first-child {
        padding-top: 0;
    }

    .hero-lista-items li:last-child {
        padding-bottom: 0;
        border-bottom: none;
    }

    .hero-lista-items a {
        display: flex;
        flex-direction: column;
        gap: 4px;
        text-decoration: none;
        color: var(--carbon);
    }

    .hero-lista-tiempo {
        font-family: var(--fuente-cuerpo);
        color: var(--rojo-konce);
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .hero-lista-titulo-item {
        font-family: 'Playfair Display', serif;
        font-weight: 600;
        font-size: 0.92rem;
        line-height: 1.3;
    }

    .hero-lista-items a:hover .hero-lista-titulo-item {
        color: var(--rojo-konce);
    }

    .noticias-grid-compacta {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        padding-bottom: 28px;
        margin-bottom: 28px;
        border-bottom: 1px solid var(--rojo-konce);
    }

    .bloque-resto {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 32px;
        padding-bottom: 28px;
        margin-bottom: 28px;
        border-bottom: 1px solid var(--rojo-konce);
    }

    .bloque-resto:last-child {
        border-bottom: none;
    }

    .bloque-item :global(.tarjeta) {
        border-bottom: none;
        padding-bottom: 0;
        margin-bottom: 0;
    }

    .bloque-teasers-fila {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 32px;
        padding-top: 20px;
        border-top: 1px dashed var(--borde-suave);
    }

    .bloque-teasers-fila-item:only-child {
        grid-column: 1 / -1;
    }

    .bloque-teasers-fila a {
        text-decoration: none;
        color: var(--carbon);
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        font-size: 1.2rem;
        line-height: 1.35;
    }

    .bloque-teasers-fila a:hover {
        color: var(--rojo-konce);
    }

    @media (max-width: 900px) {
        .hero-categoria {
            grid-template-columns: 1fr;
        }

        .noticias-grid-compacta {
            grid-template-columns: repeat(2, 1fr);
        }

        .bloque-resto {
            grid-template-columns: 1fr;
        }

        .bloque-teasers-fila {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 640px) {
        .hero-principal-titulo {
            font-size: 1.4rem;
        }

        .noticias-grid-compacta {
            grid-template-columns: 1fr;
        }
    }
</style>
