---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
    const noticias = await getCollection('noticias');
    return noticias.map((noticia) => ({
        params: { slug: noticia.id },
        props: { noticia },
    }));
}

const { noticia } = Astro.props;
const { Content } = await render(noticia);
const { titulo, resumen, categoria, imagen, imagenCredito, fuenteNombre, fuenteUrl, fecha } = noticia.data;

const urlArticulo = new URL(`/noticias/${noticia.id}/`, Astro.site).toString();
const linkWhatsapp = `https://wa.me/?text=${encodeURIComponent(`${titulo} ${urlArticulo}`)}`;
const linkFacebook = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(urlArticulo)}`;
const linkX = `https://twitter.com/intent/tweet?text=${encodeURIComponent(titulo)}&url=${encodeURIComponent(urlArticulo)}`;
---

<Layout title={titulo} description={resumen} image={imagen} type="article" publishedTime={fecha}>
    <main class="pagina-articulo">
        <div class="articulo-hero">
            {imagen && (
                <img
                    src={imagen}
                    alt={titulo}
                    width={1600}
                    height={900}
                    class="hero-imagen"
                    onerror="this.onerror=null;this.src='/placeholder.svg';"
                />
            )}
            <div class="hero-chyron contenedor">
                <span class="hero-categoria">{categoria}</span>
                <h1 class="hero-titulo">{titulo}</h1>
                <p class="hero-meta">
                    {fecha.toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Santiago' })}
                    {imagenCredito && ` · Imagen: ${imagenCredito}`}
                </p>
            </div>
        </div>

        <div class="contenedor cuerpo-articulo">
            <div class="layout-con-sidebar">
                <div class="columna-principal">
                    <article class="prosa">
                        <Content />
                    </article>

                    <div class="barra-compartir">
                        <span class="compartir-etiqueta">Compartir</span>
                        <a href={linkWhatsapp} target="_blank" rel="noopener noreferrer" class="compartir-boton" aria-label="Compartir en WhatsApp" title="WhatsApp">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.001 2C6.478 2 2 6.477 2 12c0 1.876.514 3.633 1.409 5.135L2 22l4.995-1.379A9.947 9.947 0 0 0 12.001 22C17.523 22 22 17.523 22 12S17.523 2 12.001 2zm0 18.093a8.06 8.06 0 0 1-4.13-1.132l-.296-.176-3.076.849.82-3.008-.192-.309A8.08 8.08 0 0 1 3.907 12c0-4.465 3.63-8.093 8.094-8.093 4.464 0 8.093 3.628 8.093 8.093 0 4.465-3.629 8.093-8.093 8.093z"/></svg>
                        </a>
                        <a href={linkFacebook} target="_blank" rel="noopener noreferrer" class="compartir-boton" aria-label="Compartir en Facebook" title="Facebook">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M22 12.061C22 6.505 17.523 2 12 2S2 6.505 2 12.061c0 5.022 3.657 9.184 8.438 9.939v-7.03H7.898v-2.909h2.54V9.845c0-2.522 1.492-3.915 3.777-3.915 1.094 0 2.238.197 2.238.197v2.475h-1.26c-1.243 0-1.63.775-1.63 1.57v1.888h2.773l-.443 2.909h-2.33V22c4.78-.755 8.437-4.917 8.437-9.939z"/></svg>
                        </a>
                        <a href={linkX} target="_blank" rel="noopener noreferrer" class="compartir-boton" aria-label="Compartir en X" title="X (Twitter)">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                        </a>
                        <button type="button" class="compartir-boton" id="boton-copiar-link" aria-label="Copiar link" title="Copiar link">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.07 0l2.83-2.83a5 5 0 0 0-7.07-7.07L11.5 4.5"/><path d="M14 11a5 5 0 0 0-7.07 0L4.1 13.83a5 5 0 0 0 7.07 7.07L12.5 19.5"/></svg>
                        </button>
                        <span class="compartir-estado" id="compartir-estado" role="status"></span>
                    </div>

                    <p class="fuente-box">
                        {fuenteNombre === 'The Epoch Times en Español' ? (
                            <>Fuente original: <a href={fuenteUrl} target="_blank" rel="noopener noreferrer nofollow">{fuenteNombre}</a></>
                        ) : (
                            <>Fuente original: {fuenteNombre}</>
                        )}
                    </p>

                    <a href="/" class="volver">&larr; Volver a Últimas Noticias</a>
                </div>

                <Sidebar />
            </div>
        </div>
    </main>
</Layout>

<script>
    const boton = document.getElementById('boton-copiar-link') as HTMLButtonElement | null;
    const estado = document.getElementById('compartir-estado') as HTMLSpanElement | null;

    boton?.addEventListener('click', async () => {
        try {
            await navigator.clipboard.writeText(window.location.href);
            if (estado) {
                estado.textContent = '¡Link copiado!';
                setTimeout(() => (estado.textContent = ''), 2500);
            }
        } catch {
            if (estado) estado.textContent = 'No se pudo copiar.';
        }
    });
</script>

<style>
    .articulo-hero {
        position: relative;
        background: var(--azul-estudio);
    }

    .hero-imagen {
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 9;
        max-height: 640px;
        object-fit: cover;
        object-position: top;
        display: block;
        opacity: 0.55;
    }

    .hero-chyron {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        padding: 24px 20px;
        background: linear-gradient(0deg, rgba(14, 27, 46, 0.98), rgba(14, 27, 46, 0.4));
    }

    .hero-categoria {
        display: inline-block;
        background: var(--rojo-konce);
        color: white;
        font-family: var(--fuente-display);
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        padding: 4px 12px;
        margin-bottom: 12px;
    }

    .hero-titulo {
        color: white;
        font-size: 2.2rem;
        line-height: 1.2;
        font-family: 'Playfair Display', serif;
        font-weight: 800;
        text-transform: none;
        letter-spacing: normal;
    }

    .hero-meta {
        font-family: var(--fuente-mono);
        color: var(--gris-metalico);
        font-size: 0.8rem;
        margin-top: 12px;
    }

    .cuerpo-articulo {
        padding: 30px 20px 20px;
    }

    .prosa {
        line-height: 1.8;
        font-size: 1.1rem;
        color: var(--carbon);
        font-family: 'Lora', serif;
    }

    .barra-compartir {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #e5e7eb;
    }

    .compartir-etiqueta {
        font-family: var(--fuente-display);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--gris-metalico);
        margin-right: 4px;
    }

    .compartir-boton {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--blanco-senal);
        color: var(--azul-estudio);
        border: 1px solid #e5e7eb;
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease;
    }

    .compartir-boton:hover {
        background: var(--rojo-konce);
        color: white;
        border-color: var(--rojo-konce);
    }

    .compartir-estado {
        font-family: var(--fuente-mono);
        font-size: 0.78rem;
        color: var(--rojo-konce);
    }

    .fuente-box {
        margin-top: 30px;
        padding: 15px 18px;
        background: var(--blanco-senal);
        border-left: 4px solid var(--rojo-konce);
        border-radius: 4px;
        font-size: 14px;
        color: #4b5563;
    }

    .fuente-box a {
        color: var(--azul-estudio);
        font-weight: 600;
        text-decoration: none;
    }

    .fuente-box a:hover {
        color: var(--rojo-konce);
    }

    .volver {
        display: inline-block;
        margin-top: 20px;
        color: var(--azul-estudio);
        text-decoration: none;
        font-family: var(--fuente-display);
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .volver:hover {
        color: var(--rojo-konce);
    }
</style>
