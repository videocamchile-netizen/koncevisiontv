---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
    const noticias = await getCollection('noticias');
    return noticias.map((noticia) => ({
        params: { slug: noticia.id },
        props: { noticia },
    }));
}

const { noticia } = Astro.props;
const { Content } = await render(noticia);
const { titulo, resumen, categoria, imagen, imagenCredito, fuenteNombre, fuenteUrl, fecha } = noticia.data;
---

<Layout title={titulo} description={resumen} image={imagen} type="article" publishedTime={fecha}>
    <main class="pagina-articulo">
        <div class="articulo-hero">
            {imagen && <img src={imagen} alt={titulo} class="hero-imagen" />}
            <div class="hero-chyron contenedor">
                <span class="hero-categoria">{categoria}</span>
                <h1 class="hero-titulo">{titulo}</h1>
                <p class="hero-meta">
                    {fecha.toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric' })}
                    {imagenCredito && ` · Imagen: ${imagenCredito}`}
                </p>
            </div>
        </div>

        <div class="contenedor cuerpo-articulo">
            <div class="layout-con-sidebar">
                <div class="columna-principal">
                    <article class="prosa">
                        <Content />
                    </article>

                    <p class="fuente-box">
                        Fuente original: <a href={fuenteUrl} target="_blank" rel="noopener noreferrer nofollow">{fuenteNombre}</a>
                    </p>

                    <a href="/" class="volver">&larr; Volver a Últimas Noticias</a>
                </div>

                <Sidebar />
            </div>
        </div>
    </main>
</Layout>

<style>
    .articulo-hero {
        position: relative;
        background: var(--azul-estudio);
    }

    .hero-imagen {
        width: 100%;
        aspect-ratio: 16 / 9;
        max-height: 640px;
        object-fit: cover;
        object-position: top;
        display: block;
        opacity: 0.55;
    }

    .hero-chyron {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        padding: 24px 20px;
        background: linear-gradient(0deg, rgba(14, 27, 46, 0.98), rgba(14, 27, 46, 0.4));
    }

    .hero-categoria {
        display: inline-block;
        background: var(--rojo-konce);
        color: white;
        font-family: var(--fuente-display);
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        padding: 4px 12px;
        margin-bottom: 12px;
    }

    .hero-titulo {
        color: white;
        font-size: 2rem;
        line-height: 1.15;
    }

    .hero-meta {
        font-family: var(--fuente-mono);
        color: var(--gris-metalico);
        font-size: 0.8rem;
        margin-top: 12px;
    }

    .cuerpo-articulo {
        padding: 30px 20px 20px;
    }

    .prosa {
        line-height: 1.8;
        font-size: 1.1rem;
        color: var(--carbon);
    }

    .fuente-box {
        margin-top: 30px;
        padding: 15px 18px;
        background: var(--blanco-senal);
        border-left: 4px solid var(--rojo-konce);
        border-radius: 4px;
        font-size: 14px;
        color: #4b5563;
    }

    .fuente-box a {
        color: var(--azul-estudio);
        font-weight: 600;
        text-decoration: none;
    }

    .fuente-box a:hover {
        color: var(--rojo-konce);
    }

    .volver {
        display: inline-block;
        margin-top: 20px;
        color: var(--azul-estudio);
        text-decoration: none;
        font-family: var(--fuente-display);
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .volver:hover {
        color: var(--rojo-konce);
    }
</style>
