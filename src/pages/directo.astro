---
import Layout from '../layouts/Layout.astro';

const RUMBLE_EMBED_URL = 'https://www.bitchute.com/embed/K8IdEnmuzcFk/';
---

<Layout title="Directo Sin Censura" description="Transmisión en vivo de Koncevision TV, sin depender de plataformas que censuran contenido.">
    <main class="contenedor pagina-directo">
        <div class="banner-directo">
            <span class="punto-en-vivo"></span>
            <h1 class="titulo-directo">Directo Sin Censura</h1>
        </div>
        <p class="subtitulo-directo">Transmisión en vivo de Koncevision TV, alojada fuera de las plataformas que censuran contenido.</p>

        <div class="reproductor-directo">
            <iframe
                src={RUMBLE_EMBED_URL}
                title="Directo Sin Censura — Koncevision TV"
                frameborder="0"
                allow="autoplay; fullscreen"
                allowfullscreen
            ></iframe>
        </div>
    </main>
</Layout>

<style>
    .pagina-directo {
        padding: 40px 20px;
    }

    .banner-directo {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .punto-en-vivo {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: var(--rojo-konce);
        animation: parpadeo 1.4s ease-in-out infinite;
        flex-shrink: 0;
    }

    .titulo-directo {
        font-size: 2.4rem;
        color: var(--rojo-konce);
    }

    .subtitulo-directo {
        color: #4b5563;
        font-size: 1.05rem;
        margin: 10px 0 30px 0;
        max-width: 640px;
    }

    .reproductor-directo {
        position: relative;
        aspect-ratio: 16 / 9;
        background: var(--azul-estudio);
        border: 3px solid var(--rojo-konce);
        border-radius: 4px;
        overflow: hidden;
    }

    .reproductor-directo iframe {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
    }

    @keyframes parpadeo {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.25; }
    }

    @media (prefers-reduced-motion: reduce) {
        .punto-en-vivo {
            animation: none;
        }
    }
</style>
