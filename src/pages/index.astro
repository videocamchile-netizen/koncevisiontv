---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import ViewfinderFrame from '../components/ViewfinderFrame.astro';
import { getCollection } from 'astro:content';

const noticias = (await getCollection('noticias')).sort(
    (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf(),
);
const [destacada, ...resto] = noticias;
---

<Layout title="Noticias al Instante">
    <main class="contenedor pagina">
        {destacada && (
            <section class="destacada">
                <ViewfinderFrame>
                    <a href={`/noticias/${destacada.id}`} class="destacada-imagen-link">
                        <img
                            src={destacada.data.imagen || '/placeholder.svg'}
                            alt={destacada.data.titulo}
                            class="destacada-imagen"
                        />
                        <div class="destacada-chyron">
                            <span class="destacada-categoria">{destacada.data.categoria}</span>
                            <h1 class="destacada-titulo">{destacada.data.titulo}</h1>
                        </div>
                    </a>
                </ViewfinderFrame>
                <p class="destacada-resumen">{destacada.data.resumen}</p>
            </section>
        )}

        <section class="ultimas">
            <h2 class="ultimas-titulo">Últimas Noticias</h2>

            {noticias.length === 0 && (
                <div class="vacio">
                    <p>Todavía no hay noticias publicadas — el pipeline automático está por comenzar a publicar.</p>
                    <a href="https://www.youtube.com/@KoncevisionTV" target="_blank" rel="noopener noreferrer" class="vacio-cta">
                        ▶ Mientras tanto, síguenos en YouTube
                    </a>
                </div>
            )}

            <div class="noticias-grid">
                {resto.map((noticia) => (
                    <NewsCard
                        categoria={noticia.data.categoria}
                        enlace={`/noticias/${noticia.id}`}
                        imagenUrl={noticia.data.imagen}
                        resumen={noticia.data.resumen}
                        titulo={noticia.data.titulo}
                    />
                ))}
            </div>
        </section>
    </main>
</Layout>

<style>
    .pagina {
        padding: 32px 20px 20px;
    }

    .destacada {
        margin-bottom: 20px;
    }

    .destacada-imagen-link {
        display: block;
        position: relative;
        text-decoration: none;
    }

    .destacada-imagen {
        width: 100%;
        height: 420px;
        object-fit: cover;
        display: block;
    }

    .destacada-chyron {
        position: absolute;
        left: 0;
        bottom: 0;
        max-width: 90%;
        background: linear-gradient(0deg, rgba(14, 27, 46, 0.95), rgba(14, 27, 46, 0.7));
        padding: 20px 24px;
    }

    .destacada-categoria {
        display: inline-block;
        background: var(--rojo-konce);
        color: white;
        font-family: var(--fuente-display);
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        padding: 4px 12px;
        margin-bottom: 10px;
    }

    .destacada-titulo {
        color: white;
        font-size: 2.2rem;
        line-height: 1.1;
    }

    .destacada-resumen {
        font-family: var(--fuente-cuerpo);
        color: #4b5563;
        margin-top: 16px;
        font-size: 1.05rem;
        line-height: 1.6;
    }

    .ultimas {
        margin-top: 20px;
    }

    .ultimas-titulo {
        border-bottom: 3px solid var(--rojo-konce);
        padding-bottom: 10px;
        margin-bottom: 20px;
        font-size: 1.7rem;
    }

    .vacio {
        background: var(--azul-estudio);
        color: var(--blanco-senal);
        padding: 40px 24px;
        border-radius: 4px;
        text-align: center;
    }

    .vacio-cta {
        display: inline-block;
        margin-top: 16px;
        background: var(--rojo-konce);
        color: white;
        text-decoration: none;
        padding: 10px 18px;
        border-radius: 4px;
        font-family: var(--fuente-display);
        letter-spacing: 0.03em;
        text-transform: uppercase;
    }

    .vacio-cta:hover {
        background: var(--rojo-konce-oscuro);
    }

    @media (max-width: 640px) {
        .destacada-imagen {
            height: 280px;
        }
        .destacada-titulo {
            font-size: 1.6rem;
        }
    }
</style>
