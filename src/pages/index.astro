---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import AdBanner from '../components/AdBanner.astro';
import { getCollection } from 'astro:content';

const noticias = (await getCollection('noticias')).sort(
    (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf(),
);
---

<Layout title="Noticias al Instante">
    <header style="background: #111827; color: white; padding: 25px 20px; text-align: center;">
        <h1 style="margin: 0; font-size: 2rem;">Koncevision TV</h1>
        <p style="margin: 5px 0 0 0; color: #9ca3af; font-size: 14px;">Noticias al Instante</p>
    </header>

    <main style="max-width: 800px; margin: 0 auto; padding: 20px;">
        <AdBanner ubicacion="Cabecera Principal (800x150)" />

        <section style="margin-top: 40px;">
            <h2 style="border-bottom: 2px solid #ef4444; padding-bottom: 10px; margin-bottom: 20px;">Últimas Noticias</h2>

            {noticias.length === 0 && (
                <p style="color: #6b7280;">Todavía no hay noticias publicadas. Vuelve pronto.</p>
            )}

            <div class="noticias-grid">
                {noticias.map((noticia) => (
                    <NewsCard
                        categoria={noticia.data.categoria}
                        enlace={`/noticias/${noticia.id}`}
                        imagenUrl={noticia.data.imagen}
                        resumen={noticia.data.resumen}
                        titulo={noticia.data.titulo}
                    />
                ))}
            </div>
        </section>

        <AdBanner ubicacion="Medio Artículo (Intersticial)" />
    </main>
</Layout>
